# Copy this file to .env and fill in the values.
#   cp .env.example .env
# .env is git-ignored — never commit real secrets.


# ── Database ─────────────────────────────────────────────────────────────────
# Two supported setups — pick one.
#
# 1. Local / self-hosted: a SQLite file. This is the default; leave the
#    TURSO_* variables empty and run `npm run db:migrate` once.
DATABASE_URL="file:./dev.db"
#
# 2. Serverless hosting (Vercel and friends): the filesystem is read-only, so
#    the database lives on Turso (hosted libSQL, same SQLite schema). Set both
#    variables below and DATABASE_URL is ignored at runtime. Then apply the
#    schema with `npm run db:migrate-turso`, or paste docs/schema.sql into the
#    Turso SQL console.
#      turso db create my-app
#      turso db show my-app --url        # -> TURSO_DATABASE_URL
#      turso db tokens create my-app     # -> TURSO_AUTH_TOKEN
# TURSO_DATABASE_URL=libsql://your-database.turso.io
# TURSO_AUTH_TOKEN=
